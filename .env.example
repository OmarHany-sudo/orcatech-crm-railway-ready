# OrcaTech CRM — Railway production example
# Configure these variables in Railway; never commit a real .env file or secrets.

APP_NAME="OrcaTech CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
ASSET_URL=

# Public sales demo only. Set DEMO_MODE=false for a real customer installation.
DEMO_MODE=true
DEMO_USER_NAME="OrcaTech Demo User"
DEMO_USER_EMAIL=demo@orcatech.test
DEMO_USER_PASSWORD="OrcaTech-Demo-2026!"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=\Monolog\Formatter\JsonFormatter
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Railway MySQL service provides MYSQL_URL or MYSQLHOST/MYSQLPORT/MYSQLDATABASE/
# MYSQLUSER/MYSQLPASSWORD. DB_URL and DB_* are also supported by the app.
DB_CONNECTION=mysql
DB_URL=
MYSQL_URL=
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Railway-demo-safe defaults: no Redis, worker, or WebSocket server required.
BROADCAST_DRIVER=null
CACHE_STORE=file
CACHE_DRIVER=file
# The demo stores only non-critical local files. Add a Railway volume at
# /var/www/html/storage/app/public and set FILESYSTEM_DISK=public if uploads must persist.
FILESYSTEM_DISK=local
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
QUEUE_CONNECTION=sync

# Set this only if the host explicitly provides Redis and you intend to use it.
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

# Safe demo mail transport. Change only when a verified, non-customer SMTP is ready.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Optional third-party services. Keep empty in the public demo unless intentionally configured.
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
SENTRY_DSN=
TELESCOPE_ENABLED=false
TINY_MCE_API_KEY=
ENSO_API_TOKEN=
WIKITREE_API=

# OAuth / social / messaging / marketing integrations (optional).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v18.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=${APP_URL}/oauth/twitter-oauth-2/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=${APP_URL}/oauth/linkedin-openid/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
TWILIO_CLIENT_ID=
TWILIO_CLIENT_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_REDIRECT_URI=${APP_URL}/oauth/twilio/callback
TWILIO_PHONE_NUMBER=
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=
MAILCHIMP_REDIRECT_URI=${APP_URL}/oauth/mailchimp/callback
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=${APP_URL}/oauth/google/callback
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=${APP_URL}/oauth/zoom/callback
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=${APP_URL}/oauth/outlook/callback
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_SSL=true
POP3_HOST=
POP3_PORT=110
POP3_USERNAME=
POP3_PASSWORD=
POP3_SSL=false
SMTP_HOST=
SMTP_PORT=587

# OAuth stateful domains must match the actual public hostname; do not leave localhost here.
SANCTUM_STATEFUL_DOMAINS=example.com

# Keep subscription/payment integrations disabled in a public demo.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CLIENT_ID=
STRIPE_SUBSCRIPTIONS_ENABLED=false
STRIPE_TRIAL_DAYS=14
STRIPE_MAX_TEAM_USERS=5
STRIPE_PRICE_ID=

# Optional social publishing adapter; empty values make the UI remain in demo/add-on state.
ZERNIO_BASE_URL=https://zernio.com/api/v1
ZERNIO_API_KEY=
ZERNIO_PROFILE_ID=
ZERNIO_MODE=fallback

# Reverb / Echo remain unused in the Railway single-service demo.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_SERVER=reverb
LARAVEL_ECHO_SERVER_REDIS_HOST=
LARAVEL_ECHO_SERVER_REDIS_PORT=6379
LARAVEL_ECHO_SERVER_DEBUG=false
